{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(ai|ai\\.md)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "ai.dirthaven.net"
        }
      ],
      "destination": "/ai",
      "permanent": false
    },
    {
      "source": "/ai-persona",
      "destination": "/ai",
      "permanent": true
    },
    {
      "source": "/ai-persona.md",
      "destination": "/ai",
      "permanent": true
    },
    {
      "source": "/ai-persona.txt",
      "destination": "/ai",
      "permanent": true
    },
    {
      "source": "/ai.txt",
      "destination": "/ai",
      "permanent": true
    }
  ]
}
