---
import { Image } from 'astro:assets';
import dirthavenLogo from '../assets/dirthaven-logo.svg';
import heroImage from '../assets/doll.jpg';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="site-header">
  <h1 class="logo-wrap">
    <a href="/" title="dirthaven.net - Home">
      <img
        src={dirthavenLogo.src}
        width={dirthavenLogo.width}
        height={dirthavenLogo.height}
        alt="dirthaven"
        class="header-logo"
      />
    </a>
  </h1>

  {currentPath === '/' && (
    <figure class="hero">
      <Image
        src={heroImage}
        alt=""
        widths={[480, 960]}
        sizes="(max-width: 520px) 100vw, 472px"
        loading="eager"
        class="hero-img"
      />
    </figure>
  )}

  <nav class="site-nav">
    <div class="nav-brand">
      <a href="/">dirt[haven]</a>
    </div>
    <ul class="nav-links">
      <li><a href="/" class={currentPath === '/' ? 'active' : ''}>[home]</a></li>
      <li><a href="/about" class={currentPath === '/about' ? 'active' : ''}>[about]</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    margin-bottom: 1.5rem;
  }
  .header-logo {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.95));
  }
  .hero {
    margin: -0.5rem 0 1.25rem;
  }
  .hero :global(.hero-img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .nav-links a.active {
    color: var(--fg-strong) !important;
    text-decoration: underline;
  }
</style>
