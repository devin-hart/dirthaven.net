---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="dirthaven.net" description="Music, art, and creative projects from the underground.">
  <section class="dh-card">
    <div class="dh-card-head">
      <strong>Entries</strong>
      <small>{posts.length} article{posts.length === 1 ? '' : 's'}</small>
    </div>
    {posts.length > 0 ? (
      <div class="posts-list">
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id}
            tags={post.data.tags}
          />
        ))}
      </div>
    ) : (
      <p class="dh-empty">Nothing here yet.</p>
    )}
  </section>
</BaseLayout>

<style>
  .posts-list {
    display: flex;
    flex-direction: column;
  }
</style>
